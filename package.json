{
  "name": "@karthi/website",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "dev": "turbo run next:dev",
    "build": "turbo run next:build",
    "next:dev": "next dev",
    "next:build": "next build",
    "start": "next start",
    "lint": "turbo run lint",
    "barrels": "tsx scripts/generate-barrels.ts",
    "clean": "turbo clean && node -e \"require('fs').rmSync('.next', { recursive: true, force: true })\""
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "next": "^15.1.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "eslint": "^9.20.1",
    "eslint-config-next": "^15.1.7",
    "tsx": "^4.19.3",
    "turbo": "^2.11.8",
    "typescript": "^5.7.3"
  }
}
