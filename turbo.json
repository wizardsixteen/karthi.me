{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["barrels"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "barrels": {
      "outputs": [
        "src/elements/**/index.ts",
        "src/index.ts"
      ]
    },
    "lint": {},
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
