{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@karthi": ["./src/elements/index.ts"],
      "@karthi/ui": ["./src/elements/ui/index.ts"],
      "@karthi/data": ["./src/elements/data/index.ts"],
      "@karthi/hooks": ["./src/elements/hooks/index.ts"],
      "@karthi/providers": ["./src/elements/providers/index.ts"],
      "@karthi/types": ["./src/elements/types/index.ts"],
      "@karthi/styles": ["./src/elements/styles/index.css"],
      "@karthi/styles/*": ["./src/elements/styles/*"],
      "@karthi/*": ["./src/elements/*"],
      "@karthi/public/*": ["./public/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
